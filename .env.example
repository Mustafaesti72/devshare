APP_URL=http://localhost:3000
# HTTPS APP_URL enables indexing. Set false for staging.
ALLOW_INDEXING=true
# Future integration only; not consumed by this foundation yet:
# DATABASE_URL=postgresql://...
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# AUTH_SECRET=

# Production uses Railway private references. Keep values in Railway variables.
# DATABASE_URL=
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
